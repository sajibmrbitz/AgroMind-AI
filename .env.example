# AgroMind AI Environment Configuration Template
# Copy this file to .env and provide your Gemini API key (optional).
# If left empty, AgroMind AI will operate smoothly using the deterministic local offline advisory.

# Google Gemini API Key
GEMINI_API_KEY=

# Preferred Gemini Model (Defaults to gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash
